# Keep the build context small and avoid copying local state into the image.
.git/
.gitignore
.venv/
venv/
__pycache__/
*.py[cod]

# Never bake data or local-only notes into the image.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.env
# Local dev uploads — in the container these live on the volume (/data/uploads).
app/static/uploads/

# Tooling / docs not needed at runtime.
.claude/
deploy/
seed/
*.md
Containerfile
.containerignore
