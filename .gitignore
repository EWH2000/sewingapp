# Python
__pycache__/
*.py[cod]
.venv/
venv/

# SQLite — lives on the container's named volume, never in the repo
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Node deps for the tools/ reference scripts — reinstall with `npm install`
# (package.json / package-lock.json ARE committed). The app's pdf-lib is the
# single vendored file app/static/js/vendor/pdf-lib.min.js, which IS committed.
node_modules/

# Generated, reproducible artifacts from the tools/ generators
tools/**/*.pdf
tools/**/*.png

# OS / editor cruft
.DS_Store
*.swp
*~

# local debugging screenshots (not source) — incl. the owner's pasted issue screenshots
Screenshots/
ArmsIssue*.png

# Internal session handoffs / dev notes — they narrate the owner's hands-on reviews,
# directives, device, and reactions (private/relational user info). Keep them LOCAL,
# off the public remote. The checked-in project docs (CLAUDE.md, DESIGN.md, PREVIEW.md,
# PRINTING.md, README.md) stay tracked — gitignoring those would break the project.
HANDOFF-*.md
